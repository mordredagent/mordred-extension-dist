{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Mordred",
  "version": "0.2.2",
  "description": "Mordred Browser Extension — chat, E2E-encrypted Slack, and Web3 wallet bridge to a local Mordred-Hermes agent.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mordred",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:7788/*",
    "http://127.0.0.1:7788/*",
    "https://app.slack.com/*",
    "https://*.slack.com/*",
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://cdn.discordapp.com/*",
    "https://media.discordapp.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.slack.com/*",
        "https://*.slack.com/*"
      ],
      "js": [
        "content-slack.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://*.discord.com/*"
      ],
      "js": [
        "content-discord.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.slack.com/*",
        "https://*.slack.com/*"
      ],
      "js": [
        "injected-slack-quill.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content-web3.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "injected-provider.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}